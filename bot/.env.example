# --- RPC (optional; public defaults are used when unset) ---
BASE_RPC_URL=https://base-rpc.publicnode.com
BASE_WS_URL=wss://base-rpc.publicnode.com
BASE_PRECONF_RPC_URL=https://mainnet-preconf.base.org
BASE_FLASHBLOCKS_WS=wss://mainnet.flashblocks.base.org/ws
ARBITRUM_RPC_URL=https://arbitrum-one-rpc.publicnode.com
MAINNET_RPC_URL=https://ethereum-rpc.publicnode.com

# --- execution (live mode only) ---
# ARB_CONTRACT=0x...          # deployed ArbExecutor
# PRIVATE_KEY=0x...           # hot wallet registered via setExecutor(); keep tiny ETH balance for gas only
# SUBMIT_RPC_URLS=            # comma-separated extra endpoints to broadcast to (e.g. a sequencer endpoint)
BID_FRACTION=0.5              # share of simulated net profit bid as priority fee
MAX_PRIORITY_GWEI=0.05
MAX_FEE_GWEI=0.5
BLOCKS_VALID=2

# --- logging ---
LOG_LEVEL=info
