# node
node_modules/
dist/
*.tsbuildinfo
# foundry
contracts/out/
contracts/cache/
contracts/broadcast/
# secrets & local data
.env
.env.*
!.env.example
bot/data/
*.log
# research-material: collector working state (transient, regenerated by the collectors)
research-material/.sentinels/
research-material/**/collect/work/
research-material/**/collect/state/
research-material/**/__pycache__/
*.pyc
# raw receipt chunks (large; the processed census tables next to them are committed and the collector can regenerate them)
research-material/**/census/raw/
# TEMPORARY: Base census data is still being written by its collector; committed once BASE_CENSUS.DONE exists
research-material/05-base-onchain/data/
# V4 Initialize originals (1.8 GB, local only). The committed copy is 01-v4-pools/initialize-compact/, which rebuilds them exactly (see compact-index.json)
research-material/01-v4-pools/initialize-part-*.csv.gz
# raw Solana getBlock dumps (540 MB) and per-slot part files; the processed Solana tables built from them are committed
research-material/**/raw-slots/
research-material/**/*.parts/
# collector and engine-run logs are part of the research material
!research-material/**/*.log
