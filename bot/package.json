{
  "name": "dapparb-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Multi-chain atomic DEX arbitrage searcher with flash-swap execution",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/**/*.test.ts",
    "scan": "tsx src/research/scan.ts",
    "discover": "tsx src/cli/discover.ts",
    "bot": "tsx src/main.ts"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "dotenv": "^16.4.5",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.2",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
